@page "/mot-de-passe-oublie"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Mot de passe oublié - 2gether</PageTitle>

<main class="onboarding-shell">
	<header class="onboarding-brand"><a class="brand-wordmark" href="/"><strong>2gether</strong></a></header>
	<section class="onboarding-card recovery-card" aria-labelledby="recovery-title">
		<a class="back-link" href="/?login=true">← Retour à la connexion</a>
		<p class="eyebrow">RÉCUPÉRATION DU COMPTE</p>
		<h1 id="recovery-title">Nouveau mot de passe.</h1>
		@if (isComplete)
		{
			<p class="onboarding-feedback" role="status">Ton mot de passe a été modifié. Tu peux te connecter avec le nouveau.</p>
			<a class="onboarding-next passkey-action" href="/?login=true">Me connecter</a>
		}
		else
		{
			<p class="onboarding-copy">Entre l’adresse e-mail de ton compte. Si un compte confirmé correspond à cette adresse, nous enverrons un code temporaire. Cette réponse ne révèle pas si l’adresse est enregistrée.</p>
			<form class="recovery-form" @onsubmit="RequestCodeAsync" @onsubmit:preventDefault>
				<div class="onboarding-field">
					<label for="recovery-email">Adresse e-mail</label>
					<input id="recovery-email" type="email" @bind="email" autocomplete="email" required />
				</div>
				<button class="onboarding-next" type="submit" disabled="@isBusy">@(isBusy ? "Envoi…" : "Envoyer un code de récupération")</button>
			</form>
			@if (localEmailDelivery)
			{
				<p class="registration-step-status">Mode local : le message contenant le code est enregistré dans le dossier de courriels de test du serveur. Aucun courriel n’est envoyé sur Internet.</p>
			}
			@if (!string.IsNullOrWhiteSpace(feedback))
			{
				<p class="onboarding-feedback" role="status">@feedback</p>
			}
			@if (codeRequested)
			{
				<hr class="recovery-divider" />
				<h2>Choisir un nouveau mot de passe</h2>
				<p class="onboarding-copy">Le code expire après une heure et ne peut être utilisé qu’une seule fois.</p>
				<form class="recovery-form" @onsubmit="ResetPasswordAsync" @onsubmit:preventDefault>
					<div class="onboarding-field">
						<label for="recovery-code">Code reçu par e-mail</label>
						<input id="recovery-code" @bind="resetCode" autocomplete="one-time-code" maxlength="2048" required />
					</div>
					<div class="onboarding-field">
						<label for="recovery-new-password">Nouveau mot de passe</label>
						<input id="recovery-new-password" type="password" @bind="newPassword" autocomplete="new-password" minlength="10" required />
						<small>10 caractères minimum et au moins un chiffre.</small>
					</div>
					<div class="onboarding-field">
						<label for="recovery-confirm-password">Confirmer le nouveau mot de passe</label>
						<input id="recovery-confirm-password" type="password" @bind="confirmedPassword" autocomplete="new-password" minlength="10" required />
					</div>
					<button class="onboarding-next" type="submit" disabled="@isBusy">@(isBusy ? "Mise à jour…" : "Modifier mon mot de passe")</button>
				</form>
			}
		}
	</section>
</main>

@code {
	private string email = "";
	private string resetCode = "";
	private string newPassword = "";
	private string confirmedPassword = "";
	private string feedback = "";
	private bool codeRequested;
	private bool isComplete;
	private bool isBusy;
	private bool localEmailDelivery;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var options = await Http.GetFromJsonAsync<RegistrationEmailOptions>("/api/registration-options");
			localEmailDelivery = options?.LocalEmailDelivery == true;
		}
		catch (HttpRequestException)
		{
			feedback = "Le serveur est indisponible. Réessaie dans un instant.";
		}
	}

	private async Task RequestCodeAsync()
	{
		if (isBusy) return;
		isBusy = true;
		feedback = "";
		try
		{
			using var response = await Http.PostAsJsonAsync("/api/auth/forgotPassword", new { Email = email.Trim() });
			if (response.IsSuccessStatusCode)
			{
				codeRequested = true;
				feedback = "Si un compte confirmé correspond à cette adresse, un code vient d’être envoyé.";
			}
			else if (response.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
				feedback = "Trop de demandes. Patiente une minute avant de réessayer.";
			else
				feedback = "La demande n’a pas pu être envoyée. Vérifie ta connexion et réessaie.";
		}
		catch (HttpRequestException)
		{
			feedback = "Le serveur est indisponible. Réessaie dans un instant.";
		}
		finally { isBusy = false; }
	}

	private async Task ResetPasswordAsync()
	{
		if (isBusy) return;
		feedback = "";
		if (!string.Equals(newPassword, confirmedPassword, StringComparison.Ordinal))
		{
			feedback = "Les deux mots de passe ne correspondent pas.";
			return;
		}
		if (newPassword.Length < 10 || !newPassword.Any(character => character is >= '0' and <= '9'))
		{
			feedback = "Le nouveau mot de passe doit contenir au moins 10 caractères et un chiffre.";
			return;
		}

		isBusy = true;
		try
		{
			using var response = await Http.PostAsJsonAsync("/api/auth/resetPassword", new
			{
				Email = email.Trim(),
				ResetCode = resetCode.Trim(),
				NewPassword = newPassword
			});
			if (response.IsSuccessStatusCode)
			{
				isComplete = true;
				resetCode = "";
				newPassword = "";
				confirmedPassword = "";
			}
			else if (response.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
				feedback = "Trop de tentatives. Patiente une minute avant de réessayer.";
			else
				feedback = "Code invalide, expiré ou déjà utilisé. Demande un nouveau code et réessaie.";
		}
		catch (HttpRequestException)
		{
			feedback = "Le serveur est indisponible. Réessaie dans un instant.";
		}
		finally { isBusy = false; }
	}

	private sealed class RegistrationEmailOptions { public bool LocalEmailDelivery { get; set; } }
}
