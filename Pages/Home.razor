	private async Task LoadRemotePhotoRequestsAsync(CancellationToken cancellationToken = default)
	{
		var userId = currentUserId;
		using var response = await Http.GetAsync("/api/me/photo-requests", cancellationToken);
		if (!response.IsSuccessStatusCode) return;
		var requests = await response.Content.ReadFromJsonAsync<List<PhotoRequestResponse>>(cancellationToken) ?? [];
		if (!isAuthenticated || currentUserId != userId) return;
		state.PhotoAccessRequests = requests.Select(request => new PhotoAccessRequest { Id = request.Id.ToString(), RequesterName = request.RequesterName, RequesterId = request.RequesterId, RequestedAt = request.CreatedAt.LocalDateTime }).ToList();
	}
