	private async Task RequestLocationAsync()
	{
		isLocating = true;
		locationFeedback = "";
		try
		{
			var result = await JS.InvokeAsync<DeviceLocationResult>("deviceLocation.getCurrentPosition");
			if (!result.Success || result.Latitude is null || result.Longitude is null)
			{
				locationFeedback = result.ErrorCode switch { 1 => "Autorisation refusée. Tu peux l'activer dans les réglages du navigateur.", 2 => "Position indisponible sur cet appareil pour le moment.", 3 => "La recherche a expiré. Réessaie dans un instant.", _ => "La géolocalisation n'est pas disponible dans ce navigateur." };
				return;
			}
			if (isAuthenticated)
			{
				using var response = await Http.PostAsJsonAsync("/api/me/location", new { Latitude = result.Latitude.Value, Longitude = result.Longitude.Value, AccuracyMeters = result.AccuracyMeters ?? 0 });
				if (!response.IsSuccessStatusCode)
				{
					locationFeedback = await ReadApiErrorAsync(response, "La position n'a pas pu être enregistrée sur le serveur.");
					return;
				}
			}
			state.Latitude = result.Latitude;
			state.Longitude = result.Longitude;
			state.LocationAccuracyMeters = result.AccuracyMeters;
			locationFeedback = isAuthenticated ? "Position enregistrée sur ton compte. Seule une zone approximative est partagée." : "Position enregistrée sur cet appareil uniquement.";
			await SaveStateAsync();
		}
		catch (JSException) { locationFeedback = "La géolocalisation nécessite un navigateur compatible et HTTPS."; }
		finally { isLocating = false; }
	}
	private async Task ClearLocationAsync()
	{
		if (isAuthenticated)
		{
			using var response = await Http.DeleteAsync("/api/me/location");
			if (!response.IsSuccessStatusCode)
			{
				locationFeedback = "La position n'a pas pu être supprimée du serveur.";
				return;
			}
		}
		state.Latitude = null;
		state.Longitude = null;
		state.LocationAccuracyMeters = null;
		locationFeedback = isAuthenticated ? "Position supprimée de ton compte et de cet appareil." : "Position supprimée de cet appareil.";
		await SaveStateAsync();
	}
	private double DistanceFromUser(Profile profile) => profile.IsDemo && state.Latitude is double latitude && state.Longitude is double longitude ? CalculateDistanceKm(latitude, longitude, profile.Latitude, profile.Longitude) : profile.DemoDistanceKm;
	private static double CalculateDistanceKm(double firstLatitude, double firstLongitude, double secondLatitude, double secondLongitude)
	{
		const double earthRadiusKm = 6371.0088;
		var latitudeDelta = DegreesToRadians(secondLatitude - firstLatitude);
		var longitudeDelta = DegreesToRadians(secondLongitude - firstLongitude);
		var haversine = Math.Pow(Math.Sin(latitudeDelta / 2), 2) + Math.Cos(DegreesToRadians(firstLatitude)) * Math.Cos(DegreesToRadians(secondLatitude)) * Math.Pow(Math.Sin(longitudeDelta / 2), 2);
		return earthRadiusKm * 2 * Math.Asin(Math.Sqrt(Math.Clamp(haversine, 0, 1)));
	}
	private static double DegreesToRadians(double degrees) => degrees * Math.PI / 180;
	private async Task ResetFiltersAsync() { state.RadiusKm = 25; await SaveStateAsync(); }
	private Task SaveStateAsync()
	{
		if (isAuthenticated)
		{
			var preferences = JsonSerializer.Serialize(new { state.ProfileDisplayMode });
			return JS.InvokeVoidAsync("localStorage.setItem", "2gether.preferences.v1", preferences).AsTask();
		}
		return JS.InvokeVoidAsync("localStorage.setItem", StorageKey, JsonSerializer.Serialize(state)).AsTask();
	}

