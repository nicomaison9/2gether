	private async Task BlockMemberAsync(string profileId)
	{
		var profile = FindProfile(profileId);
		if (!isAuthenticated || profile is null || profile.IsDemo) return;
		try
		{
			if (!await JS.InvokeAsync<bool>("confirm", $"Bloquer {profile.Name} ? Vous ne verrez plus vos profils ni vos conversations respectifs."))
				return;
			using var response = await Http.PostAsync($"/api/profiles/{Uri.EscapeDataString(profileId)}/block", null);
			if (response.IsSuccessStatusCode)
			{
				state.Conversations.RemoveAll(conversation => conversation.ProfileId == profileId);
				if (activeConversationId == profileId) activeConversationId = "";
				selectedProfileId = "";
				activePage = "discover";
				await SaveStateAsync();
				await LoadNearbyProfilesAsync();
				await LoadRemoteConversationsAsync();
				toastMessage = "Ce membre est bloqué. Tu peux gérer tes blocages depuis le menu.";
			}
			else if (response.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
				toastMessage = "Trop de blocages. Patiente une minute avant de réessayer.";
			else
				toastMessage = "Ce membre n’a pas pu être bloqué. Réessaie.";
		}
		catch (JSException)
		{
			toastMessage = "La confirmation du blocage n’a pas pu être affichée.";
		}
		catch (HttpRequestException)
		{
			toastMessage = "Le serveur est indisponible. Le membre n’a pas été bloqué.";
		}
	}
	private async Task StartConversationAsync(string profileId)
	{
		var profile = FindProfile(profileId);
		activePage = "messages";
		if (isAuthenticated && profile is { IsDemo: false })
		{
			await OpenConversationAsync(profileId);
			return;
		}
		if (state.Conversations.All(item => item.ProfileId != profileId))
			state.Conversations.Add(new Conversation { ProfileId = profileId, ProfileName = profile?.Name ?? "Profil démo", Area = profile?.Area ?? "", PhotoUrl = profile?.PhotoUrl ?? CreateProfilePlaceholder("2") });
		await OpenConversationAsync(profileId);
		await SaveStateAsync();
	}
	private async Task SendMessageAsync()
	{
		var text = messageText.Trim();
		var conversation = ActiveConversation;
		if (text.Length == 0 || conversation is null || isSendingMessage) return;
		isSendingMessage = true;
		chatError = "";
		try
		{
			if (isAuthenticated && ActiveProfile is { IsDemo: false })
			{
				using var response = await Http.PostAsJsonAsync("/api/messages", new { RecipientId = conversation.ProfileId, Text = text });
				if (!response.IsSuccessStatusCode) { chatError = await ReadApiErrorAsync(response, "Le message n'a pas pu être envoyé. Ton brouillon est conservé."); return; }
				var savedMessage = await response.Content.ReadFromJsonAsync<DirectMessageResponse>();
				if (savedMessage is null) return;
				conversation.Messages.Add(new ChatMessage { Text = savedMessage.Text, SentAt = savedMessage.SentAt.LocalDateTime, IsMine = true });
			}
			else conversation.Messages.Add(new ChatMessage { Text = text, SentAt = DateTime.Now, IsMine = true });
			messageDrafts.Remove(conversation.ProfileId);
			if (activeConversationId == conversation.ProfileId) { messageText = ""; scrollChatToBottom = true; }
			await SaveStateAsync();
		}
		catch (HttpRequestException) { chatError = "Connexion interrompue. Ton message n'a pas été confirmé ; vérifie le fil avant de réessayer."; }
		finally { isSendingMessage = false; }
	}
	private async Task SaveProfileAsync()
	{
		state.Name = state.Name.Trim();
		state.City = state.City.Trim();
		if (isAuthenticated && !await EnsureRemoteProfileAsync(state.OnboardingComplete)) return;
		toastMessage = "Ton profil est enregistré sur cet appareil.";
		await SaveStateAsync();
	}
	private async Task UploadAvatarAsync(InputFileChangeEventArgs args)
	{
		try
		{
			if (isAuthenticated)
			{
				var photo = await UploadPhotoToServerAsync(args.File, "public", true);
				state.AvatarDataUrl = photo.Url;
				state.AvatarPhotoId = photo.Id.ToString();
			}
			else
			{
				state.AvatarDataUrl = await CompressPhotoAsync(args.File);
			}
			toastMessage = isAuthenticated ? "Photo de profil enregistrée sur le serveur." : "Photo de profil enregistrée sur cet appareil.";
			await SaveStateAsync();
		}
		catch (Exception exception) when (exception is IOException or InvalidDataException or JSException or HttpRequestException or InvalidOperationException)
		{
			toastMessage = "Image impossible à enregistrer. Choisis un JPEG, PNG ou WebP de moins de 5 Mo.";
		}
	}
	private async Task AddLibraryPhotosAsync(InputFileChangeEventArgs args)
	{
		var photos = ActivePhotoLibrary;
		var remaining = MaxPhotosPerLibrary - photos.Count;
		if (remaining <= 0)
		{
			toastMessage = $"Cette bibliothèque accepte au maximum {MaxPhotosPerLibrary} photos.";
			return;
		}

		IReadOnlyList<IBrowserFile> files;
		try { files = args.GetMultipleFiles(remaining); }
		catch (InvalidOperationException)
		{
			toastMessage = $"Sélectionne au maximum {remaining} photo(s) supplémentaires.";
			return;
		}

		foreach (var file in files)
		{
			try
			{
				if (isAuthenticated)
				{
					var uploaded = await UploadPhotoToServerAsync(file, activePhotoLibrary, false);
					photos.Add(new ProfilePhoto { Id = uploaded.Id.ToString(), DataUrl = uploaded.Url });
				}
				else
				{
					photos.Add(new ProfilePhoto { Id = Guid.NewGuid().ToString(), DataUrl = await CompressPhotoAsync(file) });
				}
				await SaveStateAsync();
			}
			catch (Exception exception) when (exception is IOException or InvalidDataException or JSException or HttpRequestException or InvalidOperationException)
			{
				toastMessage = "Une photo n'a pas pu être enregistrée. Essaie une image plus légère.";
				return;
			}
		}

		toastMessage = $"{files.Count} photo(s) ajoutée(s) à la bibliothèque {activePhotoLibrary}{(isAuthenticated ? " sur le serveur" : " sur cet appareil")}.";
	}
	private async Task<ProfilePhotoResponse> UploadPhotoToServerAsync(IBrowserFile file, string visibility, bool isAvatar)
	{
		await using var stream = file.OpenReadStream(5 * 1024 * 1024);
		using var multipart = new MultipartFormDataContent();
		using var fileContent = new StreamContent(stream);
		fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
		multipart.Add(fileContent, "file", Path.GetFileName(file.Name));
		var endpoint = $"/api/me/photos?visibility={Uri.EscapeDataString(visibility)}&isAvatar={isAvatar.ToString().ToLowerInvariant()}";
		using var response = await Http.PostAsync(endpoint, multipart);
		if (!response.IsSuccessStatusCode) throw new InvalidOperationException(await ReadApiErrorAsync(response, "L'envoi de la photo a échoué."));
		return await response.Content.ReadFromJsonAsync<ProfilePhotoResponse>() ?? throw new InvalidDataException("Réponse photo invalide.");
	}
	private async Task<string> CompressPhotoAsync(IBrowserFile file)
	{
		if (file.ContentType is not ("image/jpeg" or "image/png" or "image/webp"))
			throw new InvalidDataException("Format d'image non pris en charge.");

		await using var input = file.OpenReadStream(5 * 1024 * 1024);
		using var output = new MemoryStream();
		await input.CopyToAsync(output);
		var source = $"data:{file.ContentType};base64,{Convert.ToBase64String(output.ToArray())}";
		return await JS.InvokeAsync<string>("photoLibrary.compressDataUrl", source, 1200, 0.76);
	}
