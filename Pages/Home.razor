@page "/"
@implements IAsyncDisposable
@using System.Net.Http.Json
@using System.Text.Json
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>2gether - rencontres de quartier</PageTitle>

<div class="dating-app">
	@if (!state.OnboardingComplete)
	{
		<main class="onboarding-shell">
			<header class="onboarding-brand"><span class="brand-mark" aria-hidden="true">2</span><span class="brand-wordmark"><strong>2gether</strong></span><span class="onboarding-urban">RENCONTRES DE QUARTIER</span></header>
			<div class="onboarding-layout">
				<aside class="onboarding-aside"><p class="eyebrow">UNE INSCRIPTION, PUIS TA VILLE</p><h1>Rencontre<br />à ton rythme.</h1><p>Quelques repères pour faire remonter les personnes qui te ressemblent, près de toi.</p><span class="onboarding-aside-mark" aria-hidden="true">2</span></aside>
				<section class="onboarding-card" aria-labelledby="onboarding-title" @onkeydown="HandleRegistrationKeyDown">
					<div class="onboarding-progress-label"><span>ÉTAPE @(onboardingStep + 1) SUR 4</span><span>@(onboardingStep switch { 0 => "Compte", 1 => "Passions", 2 => "Localisation", _ => "Profil" })</span></div>
					<div class="onboarding-progress" role="progressbar" aria-label="Progression de l'inscription" aria-valuemin="1" aria-valuemax="4" aria-valuenow="@(onboardingStep + 1)">@for (var stepIndex = 0; stepIndex < 4; stepIndex++) { <span class="@(stepIndex <= onboardingStep ? "complete" : "")"></span> }</div>

					@if (onboardingStep == 0 && awaitingEmailConfirmation)
					{
						<div class="onboarding-step"><p class="eyebrow">UNE DERNIÈRE VÉRIFICATION</p><h2 id="onboarding-title">Vérifie ton adresse e-mail</h2><p class="onboarding-copy">Un lien de confirmation a été demandé pour <strong>@state.AccountEmail</strong>. Ouvre le message de 2gether et choisis « Confirmer mon adresse e-mail », puis reviens te connecter.</p><p class="onboarding-copy">Le lien est valable une heure. Si tu ne trouves pas le message, regarde dans les courriers indésirables.</p>
							@if (localEmailDelivery) { <p class="registration-step-status">Mode local : le message de test est enregistré sur ce PC. Aucun e-mail n'est envoyé sur Internet.</p> }
							@if (!string.IsNullOrWhiteSpace(onboardingFeedback)) { <p class="onboarding-feedback" role="status">@onboardingFeedback</p> }
							<div class="onboarding-actions"><button type="button" class="onboarding-next" @onclick="ReturnToVerifiedLogin">J'ai confirmé, me connecter</button><button type="button" class="onboarding-back" @onclick="ResendVerificationAsync" disabled="@(isSubmittingRegistration || DateTimeOffset.UtcNow < verificationResendAt)">@(isSubmittingRegistration ? "Envoi..." : DateTimeOffset.UtcNow < verificationResendAt ? "Patiente quelques secondes avant le renvoi" : "Renvoyer le lien")</button><button type="button" class="onboarding-back" @onclick="CorrectRegistrationEmail">Corriger mon adresse e-mail</button></div>
						</div>
					}
					else if (onboardingStep == 0)
					{
						<form class="onboarding-step" @onsubmit="ContinueFromAccountAsync" @onsubmit:preventDefault novalidate><p class="eyebrow">BIENVENUE SUR 2GETHER</p><h2 id="onboarding-title">On fait connaissance ?</h2><p class="onboarding-copy">@(accountMode == "create" ? "Trois informations pour créer ton compte. Tous les champs ci-dessous sont nécessaires." : "Retrouve ton compte avec ton adresse e-mail et ton mot de passe.")</p>
							<div class="account-mode-switch"><button type="button" class="@(accountMode == "create" ? "selected" : "")" @onclick="ChooseCreateAccount">Créer un compte</button><button type="button" class="@(accountMode == "existing" ? "selected" : "")" @onclick="ChooseExistingAccount">J'ai déjà un compte</button></div>
							<div class="onboarding-field"><label for="registration-email">Adresse e-mail <span class="field-required">Obligatoire</span></label><input id="registration-email" type="email" @bind="state.AccountEmail" @bind:event="oninput" @onfocus='() => ShowRegistrationHelp("email")' @onblur='() => LeaveRegistrationField("email")' aria-invalid='@RegistrationInvalid("email")' aria-describedby='@RegistrationDescription("email")' placeholder="Exemple : lea@exemple.fr" autocomplete="email" required />@RegistrationHelp("email")</div>
							<div class="onboarding-field"><label for="registration-password">Mot de passe <span class="field-required">Obligatoire</span></label><div class="registration-password-wrap"><input id="registration-password" type="@(showRegistrationPassword ? "text" : "password")" @bind="onboardingPassword" @bind:event="oninput" @onfocus='() => ShowRegistrationHelp("password")' @onblur='() => LeaveRegistrationField("password")' aria-invalid='@RegistrationInvalid("password")' aria-describedby='@RegistrationDescription("password")' autocomplete="@(accountMode == "create" ? "new-password" : "current-password")" required /><button type="button" @onclick="ToggleRegistrationPassword" aria-label="@(showRegistrationPassword ? "Masquer le mot de passe" : "Afficher le mot de passe")" aria-pressed="@showRegistrationPassword" title="@(showRegistrationPassword ? "Masquer le mot de passe" : "Afficher le mot de passe")"><span aria-hidden="true">@(showRegistrationPassword ? "◉" : "◎")</span></button></div>@RegistrationHelp("password")</div>
							@if (accountMode == "create") { <div class="onboarding-field"><label for="registration-name">Prénom ou surnom <span class="field-required">Obligatoire</span></label><input id="registration-name" @bind="state.Name" @bind:event="oninput" @onfocus='() => ShowRegistrationHelp("name")' @onblur='() => LeaveRegistrationField("name")' aria-invalid='@RegistrationInvalid("name")' aria-describedby='@RegistrationDescription("name")' maxlength="32" autocomplete="given-name" placeholder="Exemple : Léa" required />@RegistrationHelp("name")</div> }
							<p class="onboarding-privacy">Ton adresse e-mail et ton mot de passe ne sont pas affichés aux autres membres.</p>
							@if (accountSuspended) { <p class="onboarding-feedback" role="alert">L’accès à ce compte est suspendu. Tu peux contacter l’équipe qui gère 2gether ou <a href="/compte/supprimer">supprimer définitivement ton compte</a>.</p> }
							@if (!string.IsNullOrWhiteSpace(onboardingFeedback)) { <p class="onboarding-feedback" role="alert">@onboardingFeedback</p> }
							@if (accountMode == "existing") { <button class="onboarding-back" type="button" @onclick="ResendVerificationAsync" disabled="@(isSubmittingRegistration || DateTimeOffset.UtcNow < verificationResendAt)">Renvoyer le lien de vérification</button><div class="account-recovery-actions"><a href="/mot-de-passe-oublie">Mot de passe oublié ?</a><button class="onboarding-back" type="button" @onclick="LoginWithPasskeyAsync" disabled="@isSubmittingRegistration">Se connecter avec une passkey</button><p>Déverrouille ta clé d’accès avec l’empreinte, le visage ou le code de ton appareil.</p></div> }
							<button class="onboarding-next" type="submit" disabled="@isSubmittingRegistration">@(isSubmittingRegistration ? "Connexion en cours..." : accountMode == "create" ? "Créer mon compte et continuer" : "Me connecter") <span aria-hidden="true">→</span></button>
						</form>
					}
					else if (onboardingStep == 1)
					{
						<div class="onboarding-step"><p class="eyebrow">LES GRANDES LIGNES SUFFISENT</p><h2 id="onboarding-title">Qu’est-ce qui t’anime ?</h2><p class="onboarding-copy">Qu'aimes-tu faire ? Choisis au moins une activité, par exemple le cinéma ou les balades. Tu peux en choisir jusqu'à 10.</p>
							<div class="onboarding-affinity-count"><span>@state.Interests.Count / 10</span> passions choisies</div>
							<p class="registration-step-status" role="status">@(SelectedAffinityTopicIds.Count == 0 ? "Il manque une activité qui te plaît pour continuer." : "C'est bon, tu peux continuer.")</p>
							<div class="onboarding-affinity-tools"><label class="sr-only" for="onboarding-passion-search">Rechercher une passion</label><input id="onboarding-passion-search" @bind="onboardingTopicSearch" @bind:event="oninput" @bind:after="ResetOnboardingTopicResults" @onfocus='() => ShowRegistrationHelp("passion-search")' @onblur='() => LeaveRegistrationField("passion-search")' aria-describedby='@(activeRegistrationField == "passion-search" ? "registration-passion-help" : null)' placeholder="Exemple : cinéma, cuisine..." /><label class="sr-only" for="onboarding-passion-category">Filtrer les passions par catégorie</label><select id="onboarding-passion-category" @bind="onboardingTopicCategory" @bind:after="ResetOnboardingTopicResults">@foreach (var category in AffinityReasonCatalog.Categories) { <option value="@category">@category</option> }</select></div>
							@if (activeRegistrationField == "passion-search") { <div id="registration-passion-help" class="registration-help is-open" role="status">Écris un mot, puis sélectionne une activité dans les résultats. Rechercher ne sélectionne pas une activité.</div> }
							<div class="onboarding-passion-list">@foreach (var topic in VisibleOnboardingTopics) { <button type="button" class="onboarding-passion @(state.Interests.Contains(topic.Id) ? "chosen" : "")" aria-pressed="@state.Interests.Contains(topic.Id)" @onclick="() => ToggleOnboardingTopicAsync(topic.Id)"><span>@topic.Id</span><i aria-hidden="true">✓</i></button> }</div>
							@if (!VisibleOnboardingTopics.Any()) { <p class="onboarding-feedback" role="status">Aucune activité trouvée. Essaie un autre mot ou choisis « Toutes les catégories ».</p> }
							@if (VisibleOnboardingTopics.Count() < FilteredOnboardingTopics.Count()) { <button class="onboarding-show-more" type="button" @onclick="ShowMoreOnboardingTopics">Afficher les passions suivantes</button> }
							@if (!string.IsNullOrWhiteSpace(onboardingFeedback)) { <p class="onboarding-feedback" role="status">@onboardingFeedback</p> }
							<div class="onboarding-actions"><button class="onboarding-back" type="button" @onclick="GoToAccountStep">Retour</button><button class="onboarding-next" type="button" @onclick="ContinueFromPassionsAsync">Continuer <span aria-hidden="true">→</span></button></div>
						</div>
					}
					else if (onboardingStep == 2)
					{
						<div class="onboarding-step"><p class="eyebrow">À PROXIMITÉ, À TON CHOIX</p><h2 id="onboarding-title">Où te trouver ?</h2><p class="onboarding-copy">La position de ton téléphone permet de trouver des personnes dans ton quartier. Les autres membres ne voient qu'une zone approximative, jamais tes coordonnées GPS exactes.</p><p class="registration-step-status">Cette étape est facultative. Sans position, les profils proches ne pourront pas encore être affichés ; tu pourras l'ajouter plus tard.</p>
							<div class="onboarding-location-panel"><span class="onboarding-location-icon"><span class="location-pin"></span></span><div><strong>Position de cet appareil</strong><p>@(state.Latitude is null ? "Pas encore partagée" : $"Position enregistrée · précision ±{state.LocationAccuracyMeters:0} m")</p></div></div>
							@if (!string.IsNullOrWhiteSpace(locationFeedback)) { <p class="onboarding-feedback" role="status">@locationFeedback</p> }
							<button class="onboarding-gps-button" type="button" @onclick="RequestLocationAsync" disabled="@isLocating">@(isLocating ? "Recherche en cours..." : state.Latitude is null ? "Autoriser le GPS" : "Actualiser ma position")</button>
							<div class="onboarding-actions"><button class="onboarding-back" type="button" @onclick="GoToPassionsStep">Retour</button><button class="onboarding-next" type="button" @onclick="ContinueToProfileStep">Continuer <span aria-hidden="true">→</span></button><button class="onboarding-skip" type="button" @onclick="ContinueToProfileStep">Plus tard</button></div>
						</div>
					}
					else
					{
						<form class="onboarding-step" @onsubmit="CompleteOnboardingAsync" @onsubmit:preventDefault novalidate><p class="eyebrow">LES DERNIERS REPÈRES</p><h2 id="onboarding-title">Ton profil, tes mots.</h2><p class="onboarding-copy">Remplis ces quatre champs. Tu peux choisir de ne pas préciser ton genre ou ton orientation.</p>
							<div class="onboarding-field"><label for="registration-age">Ton âge en années <span class="field-required">Obligatoire</span></label><input id="registration-age" inputmode="numeric" @bind="registrationAge" @bind:event="oninput" @onfocus='() => ShowRegistrationHelp("age")' @onblur='() => LeaveRegistrationField("age")' aria-invalid='@RegistrationInvalid("age")' aria-describedby='@RegistrationDescription("age")' maxlength="3" placeholder="Exemple : 28" required />@RegistrationHelp("age")</div>
							<div class="onboarding-field"><label for="registration-gender">Ton genre <span class="field-required">Une réponse au choix</span></label><select id="registration-gender" @bind="state.Gender" @onfocus='() => ShowRegistrationHelp("gender")' @onblur='() => LeaveRegistrationField("gender")' aria-invalid='@RegistrationInvalid("gender")' aria-describedby='@RegistrationDescription("gender")' required><option value="">Choisir une réponse</option><option>Femme</option><option>Homme</option><option>Non-binaire</option><option>Autre</option><option>Je préfère ne pas préciser</option></select>@RegistrationHelp("gender")</div>
							<div class="onboarding-field"><label for="registration-orientation">Ton orientation sexuelle <span class="field-required">Une réponse au choix</span></label><select id="registration-orientation" @bind="state.SexualOrientation" @onfocus='() => ShowRegistrationHelp("orientation")' @onblur='() => LeaveRegistrationField("orientation")' aria-invalid='@RegistrationInvalid("orientation")' aria-describedby='@RegistrationDescription("orientation")' required><option value="">Choisir une réponse</option><option>Hétérosexuelle</option><option>Homosexuelle</option><option>Bisexuelle</option><option>Pansexuelle</option><option>Asexuelle</option><option>Queer</option><option>Autre</option><option>Je préfère ne pas préciser</option></select>@RegistrationHelp("orientation")</div>
							<div class="onboarding-field"><label for="registration-biography">Une phrase sur toi <span class="field-required">Obligatoire</span></label><textarea id="registration-biography" @bind="state.About" @bind:event="oninput" @onfocus='() => ShowRegistrationHelp("biography")' @onblur='() => LeaveRegistrationField("biography")' aria-invalid='@RegistrationInvalid("biography")' aria-describedby='@RegistrationDescription("biography")' maxlength="600" rows="3" placeholder="Exemple : J'aime les balades et discuter autour d'un café." required></textarea><small>@state.About.Length / 600</small>@RegistrationHelp("biography")<button class="onboarding-skip registration-bio-later" type="button" @onclick="DeferBiography">Je préfère me présenter dans la conversation</button></div>
							<p class="onboarding-privacy">Ces informations sont enregistrées sur ton compte. Les réponses de ton profil peuvent être consultées par les autres membres ; ne mets pas ton adresse ou ton numéro de téléphone dans ta présentation.</p>
							@if (!string.IsNullOrWhiteSpace(onboardingFeedback)) { <p class="onboarding-feedback" role="alert">@onboardingFeedback</p> }
							<div class="onboarding-actions"><button class="onboarding-back" type="button" @onclick="GoToLocationStep">Retour</button><button class="onboarding-next" type="submit" disabled="@isSubmittingRegistration">@(isSubmittingRegistration ? "Enregistrement..." : "Terminer et découvrir") <span aria-hidden="true">→</span></button></div>
						</form>
					}
					<p class="onboarding-demo-note">Tes informations de profil et tes passions seront enregistrées sur ton compte.</p>
				</section>
			</div>
		</main>
	}
	else
	{
	<aside class="sidebar">
		<a class="brand" href="/" aria-label="2gether, accueil">
			<span class="brand-mark" aria-hidden="true">2</span>
			<span class="brand-wordmark"><strong>2gether</strong></span>
		</a>
		<div class="nav-label">FAIRE DES RENCONTRES</div>
		<nav class="side-nav" aria-label="Navigation principale">
			<button class="nav-item @(activePage is "discover" or "profile-detail" ? "selected" : "")" @onclick="ShowDiscover"><span class="nav-symbol discover-symbol"></span><span>Découvrir</span><span class="nav-count">@VisibleProfiles.Count()</span></button>
			<button class="nav-item @(activePage == "map" ? "selected" : "")" @onclick="ShowMap"><span class="nav-symbol map-symbol"></span><span>Carte</span></button>
			<button class="nav-item @(activePage == "messages" ? "selected" : "")" @onclick="ShowMessages"><span class="nav-symbol messages-symbol"></span><span>Messages</span><span class="nav-count">@state.Conversations.Count</span></button>
			<button class="nav-item @(activePage == "profile" ? "selected" : "")" @onclick="ShowProfile"><span class="nav-symbol profile-symbol"></span><span>Mon profil</span></button>
		</nav>
		@if (isAuthenticated)
		{
			<a class="nav-item" href="/comptes-bloques">Membres bloqués</a>
			<a class="nav-item" href="/compte/supprimer">Supprimer mon compte</a>
		}
		<div class="sidebar-bottom">
			<div class="privacy-note"><span class="privacy-mark">i</span><p><strong>À toi de choisir.</strong><br />Le GPS ne s'active qu'avec ton accord.</p></div>
			<span class="demo-label">VERSION DE DÉMONSTRATION</span>
		</div>
	</aside>

	<main class="main-content">
		<header class="mobile-header">
			<a class="brand" href="/" aria-label="2gether, accueil"><span class="brand-mark" aria-hidden="true">2</span><span class="brand-wordmark"><strong>2gether</strong></span></a>
			<button class="mobile-location" @onclick="ShowProfile" aria-label="Modifier mon secteur"><span class="location-pin"></span>@state.City</button>
		</header>

		<div class="content-wrap">
			<div class="page-topline"><span class="mode-label"><span class="mode-dot"></span> @(isAuthenticated ? "Ton quartier · distances approximatives" : "Démo · localisations fictives")</span><button class="location-button" @onclick="ShowProfile"><span class="location-pin"></span><span>@state.City</span><span class="location-divider"></span><span>Rayon @state.RadiusKm km</span><span class="edit-mark" aria-hidden="true">↗</span></button></div>

			@if (activePage == "discover")
			{
				<section class="discover-view">
					<header class="discover-heading"><div><p class="eyebrow">DES AFFINITÉS, JUSTE À CÔTÉ</p><h1>Les belles rencontres<br /><em>ne sont pas si loin.</em></h1><p class="intro-copy">Des personnes qui te ressemblent, dans ton secteur.</p></div><div class="meet-note"><span class="meet-spark" aria-hidden="true">✳</span><span>Moins de swipe.<br /><strong>Plus de vrai.</strong></span></div></header>
					<details class="affinity-disclosure"><summary>Mes affinités <span>@SelectedAffinityCount sélectionnées</span></summary>
					<section class="affinity-section" aria-label="Choisir mes raisons d'affinité">
						<div class="affinity-heading"><div><span class="eyebrow">CE QUI TE FAIT VIBRER</span><p>Choisis tes raisons d'affinité</p></div><span class="affinity-hint">@SelectedAffinityCount sélectionnées · @AffinityReasonCatalog.Reasons.Count raisons</span></div>
						<div class="affinity-browser-controls"><label class="affinity-search"><span class="sr-only">Rechercher une raison d'affinité</span><input @bind="affinitySearch" @bind:event="oninput" @bind:after="ResetAffinityResults" placeholder="Rechercher une passion, une envie..." /></label><label class="affinity-category"><span class="sr-only">Filtrer par catégorie</span><select @bind="selectedAffinityCategory" @bind:after="ResetAffinityResults">@foreach (var category in AffinityReasonCatalog.Categories) { <option value="@category">@category</option> }</select></label></div>
						<div class="affinity-reason-grid">@foreach (var reason in VisibleAffinityReasons) { <button type="button" class="affinity-reason @(state.AffinityReasonIds.Contains(reason.Id) ? "selected" : "")" aria-pressed="@state.AffinityReasonIds.Contains(reason.Id)" @onclick="() => ToggleAffinityReasonAsync(reason.Id)"><span class="reason-category">@reason.Category</span><span class="reason-text">@reason.Text</span><span class="reason-check" aria-hidden="true">✓</span></button> }</div>
						@if (!VisibleAffinityReasons.Any()) { <p class="affinity-no-results">Aucune raison trouvée. Essaie un autre mot ou une autre catégorie.</p> }
						@if (VisibleAffinityReasonCount < FilteredAffinityReasonCount) { <button type="button" class="affinity-more-button" @onclick="ShowMoreAffinityReasons">Afficher les raisons suivantes <span>@(FilteredAffinityReasonCount - VisibleAffinityReasonCount) restantes</span></button> }
						<div class="interest-list quick-interests">@foreach (var interest in AllInterests) { <button class="interest-chip @(state.Interests.Contains(interest) ? "active" : "")" @onclick="() => ToggleInterestAsync(interest)">@interest</button> }</div>
					</section>
					</details>

					<div class="results-heading"><div><h2>Près de toi <span class="result-count">@VisibleProfiles.Count()</span></h2><p>Le courant passe déjà sur quelques sujets.</p></div></div>
					<div class="profile-view-toolbar">
						<label class="radius-control"><span>À moins de</span><select @bind="state.RadiusKm" @bind:after="SaveStateAsync"><option value="1">1 km</option><option value="2">2 km</option><option value="5">5 km</option><option value="10">10 km</option><option value="25">25 km</option><option value="50">50 km</option></select></label>
						<div class="profile-display-control" role="group" aria-label="Présentation des profils">
							<button type="button" class="display-mode-button @(state.ProfileDisplayMode == "small" ? "active" : "")" aria-label="Petites miniatures" aria-pressed="@(state.ProfileDisplayMode == "small")" title="Petites miniatures" @onclick="SetSmallDisplayModeAsync"><span class="display-glyph glyph-small" aria-hidden="true"></span></button>
							<button type="button" class="display-mode-button @(state.ProfileDisplayMode == "medium" ? "active" : "")" aria-label="Miniatures moyennes" aria-pressed="@(state.ProfileDisplayMode == "medium")" title="Miniatures moyennes" @onclick="SetMediumDisplayModeAsync"><span class="display-glyph glyph-medium" aria-hidden="true"></span></button>
							<button type="button" class="display-mode-button @(state.ProfileDisplayMode == "large" ? "active" : "")" aria-label="Grandes miniatures" aria-pressed="@(state.ProfileDisplayMode == "large")" title="Grandes miniatures" @onclick="SetLargeDisplayModeAsync"><span class="display-glyph glyph-large" aria-hidden="true"></span></button>
							<button type="button" class="display-mode-button @(state.ProfileDisplayMode == "list" ? "active" : "")" aria-label="Affichage en liste" aria-pressed="@(state.ProfileDisplayMode == "list")" title="Affichage en liste" @onclick="SetListDisplayModeAsync"><span class="display-glyph glyph-list" aria-hidden="true"></span></button>
						</div>
					</div>

					@if (VisibleProfiles.Any())
					{
						<div class="profile-grid view-@state.ProfileDisplayMode">
							@foreach (var profile in VisibleProfiles)
							{
								<article class="profile-card" @key="profile.Id">
										<div class="profile-photo-wrap"><button class="profile-photo-open" @onclick="() => OpenProfileAsync(profile.Id)" aria-label="Voir le profil détaillé de @profile.Name"><img class="profile-photo" src="@profile.PhotoUrl" alt="Portrait de @profile.Name" loading="lazy" /></button><div class="photo-topline"><span class="affinity-badge"><span class="affinity-star" aria-hidden="true">✳</span> @AffinityLabel(profile)</span><span class="online-mark"><span></span> @(profile.IsDemo ? "Profil démo" : "Membre 2gether")</span></div><div class="photo-gradient"></div><div class="photo-caption"><span class="distance-badge"><span class="location-pin"></span>@DistanceFromUser(profile).ToString("0.0") km · @profile.Area</span></div></div>
									<div class="profile-info">
										<div class="profile-title-row"><button class="profile-name-button" @onclick="() => OpenProfileAsync(profile.Id)"><h3>@profile.Name, @profile.Age <span aria-hidden="true">↗</span></h3></button><span class="profile-pronouns">@profile.Occupation</span></div>
										<p class="profile-bio">@profile.Bio</p>
										<div class="profile-interests">@foreach (var interest in profile.Interests) { <span class="profile-interest @(state.Interests.Contains(interest) ? "shared" : "")">@interest</span> }</div>
										<div class="profile-actions"><button class="pass-button" title="Masquer ce profil" aria-label="Masquer @profile.Name" @onclick="() => HideProfileAsync(profile.Id)">×</button><button class="message-button" @onclick="() => StartConversationAsync(profile.Id)"><span aria-hidden="true">↗</span> Dire bonjour</button><button class="like-button @(state.LikedProfileIds.Contains(profile.Id) ? "liked" : "")" aria-label="@(state.LikedProfileIds.Contains(profile.Id) ? $"Retirer le like de {profile.Name}" : $"Aimer le profil de {profile.Name}")" @onclick="() => ToggleLikeAsync(profile.Id)"><span aria-hidden="true">♥</span></button></div>
									</div>
								</article>
							}
						</div>
					}
					else
					{
						<div class="empty-discovery"><span class="empty-symbol" aria-hidden="true">⌖</span><h3>Un peu plus loin ?</h3><p>Aucun profil ne correspond à ce rayon. Élargis la recherche.</p><button class="text-button" @onclick="ResetFiltersAsync">Élargir à 25 km <span aria-hidden="true">→</span></button></div>
					}
					@if (VisibleProfiles.Any(profile => profile.IsDemo)) { <p class="demo-disclaimer">Les profils et leurs coordonnées sont fictifs. Avec le GPS, les distances comparent ta position aux coordonnées d'exemple.</p> }
				</section>
			}
			else if (activePage == "map")
			{
				<section class="map-view">
					<header class="map-heading"><div><p class="eyebrow">EXPLORER TON QUARTIER</p><h1>La carte des rencontres.</h1><p>Déplace la carte, zoome et sélectionne un marqueur pour voir le profil.</p></div><span class="map-result-count">@VisibleProfiles.Count() profils</span></header>
					<div class="map-legend"><span><i class="map-legend-profile"></i> Profil</span>@if (state.Latitude is not null) { <span><i class="map-legend-you"></i> Ta position</span> }<span class="map-radius-note">Rayon actif : @state.RadiusKm km</span></div>
					<div id="profile-map" class="profile-map" role="application" aria-label="Carte interactive des profils à proximité"></div>
					<p class="map-disclaimer">Les marqueurs de profils sont des coordonnées fictives. La carte et les tuiles nécessitent une connexion Internet.</p>
				</section>
			}
			else if (activePage == "profile-detail")
			{
				var profile = FindProfile(selectedProfileId);
				if (profile is not null)
				{
					<section class="profile-detail-view">
						<button class="back-link" @onclick="ShowDiscover"><span aria-hidden="true">←</span> Retour aux profils</button>
						<div class="profile-detail-layout">
							<div class="detail-photo-panel"><img src="@profile.PhotoUrl" alt="Portrait de @profile.Name" /><span class="detail-photo-caption">Profil de démonstration</span></div>
							<div class="detail-content"><p class="eyebrow">UNE PERSONNE, BIEN PLUS QU'UNE PHOTO</p><h1>@profile.Name, @profile.Age</h1><p class="detail-occupation">@profile.Occupation <span>·</span> @profile.Education</p>
								<div class="detail-distance"><span class="location-pin"></span>@profile.Area · @DistanceFromUser(profile).ToString("0.0") km <span>@DistanceOriginLabel</span></div>
								<section class="detail-section"><h2>À propos</h2><p>@profile.About</p></section>
								@if (selectedProfilePhotos.Any(photo => photo.Visibility == 0)) { <section class="detail-section"><h2>Photos publiques</h2><div class="visitor-photo-grid">@foreach (var photo in selectedProfilePhotos.Where(photo => photo.Visibility == 0)) { <img src="@photo.DataUrl" alt="Photo publique de @profile.Name" /> }</div></section> }
								@if (profile.PrivatePhotoCount > 0)
								{
									<section class="detail-section"><h2>Photos privées</h2>
										@if (selectedProfilePhotos.Any(photo => photo.Visibility == 1)) { <div class="visitor-photo-grid">@foreach (var photo in selectedProfilePhotos.Where(photo => photo.Visibility == 1)) { <img src="@photo.DataUrl" alt="Photo privée de @profile.Name" /> }</div> }
										else { <div class="private-lock-panel"><span aria-hidden="true">▣</span><p>@(profile.HasPendingPhotoRequest ? "Ta demande est en attente d'approbation." : "Ces photos sont visibles uniquement avec l'accord du propriétaire.")</p><button type="button" class="photo-request-button" @onclick="() => RequestPrivatePhotoAccessAsync(profile.Id)" disabled="@profile.HasPendingPhotoRequest">@(profile.HasPendingPhotoRequest ? "Demande envoyée" : "Demander l'accès")</button></div> }
									</section>
								}
								<section class="detail-section"><h2>Ses affinités</h2><div class="detail-tags">@foreach (var interest in profile.Interests) { <span class="profile-interest @(SelectedAffinityTopicIds.Contains(interest) ? "shared" : "")">@interest</span> }</div></section>
								<div class="detail-facts"><div><span>Langues</span><strong>@profile.Languages</strong></div><div><span>Style de vie</span><strong>@profile.Lifestyle</strong></div><div><span>Son intention</span><strong>@profile.Intent</strong></div><div><span>Ce qui lui correspond</span><strong>@profile.LookingFor</strong></div></div>
								<div class="detail-actions"><button class="message-button" @onclick="() => StartConversationAsync(profile.Id)"><span aria-hidden="true">↗</span> Dire bonjour</button><button class="like-button @(state.LikedProfileIds.Contains(profile.Id) ? "liked" : "")" aria-label="Aimer le profil de @profile.Name" @onclick="() => ToggleLikeAsync(profile.Id)"><span aria-hidden="true">♥</span></button></div>
								@if (isAuthenticated && !profile.IsDemo)
								{
									<div class="detail-actions">
										<a class="back-link" href="@($"/signaler/{Uri.EscapeDataString(profile.Id)}")">Signaler ce profil</a>
										<button class="signout-button" type="button" @onclick="() => BlockMemberAsync(profile.Id)">Bloquer ce membre</button>
									</div>
								}
								<p class="detail-location-note">La distance GPS est arrondie. Les coordonnées affichées appartiennent à un profil fictif.</p>
							</div>
						</div>
					</section>
				}
			}
			else if (activePage == "messages")
			{
				<section class="messages-view"><header class="subpage-heading"><p class="eyebrow">PRENDRE LE TEMPS DE SE PARLER</p><h1>Les conversations.</h1><p>Un premier message, et la suite vous appartient.</p></header>
					<div class="messages-layout @(ActiveConversation is null ? "no-conversation" : "has-conversation")">
						<aside class="conversation-list" aria-label="Mes conversations"><div class="conversation-list-heading"><h2>Messages</h2><span>@state.Conversations.Count</span></div>
							@if (state.Conversations.Count == 0) { <div class="conversation-empty"><span class="empty-symbol" aria-hidden="true">↗</span><p>Pas encore de conversation.</p><button class="text-button" @onclick="ShowDiscover">Découvrir les profils <span aria-hidden="true">→</span></button></div> }
							@foreach (var conversation in state.Conversations.OrderByDescending(item => item.Messages.LastOrDefault()?.SentAt))
							{
								var profile = FindProfile(conversation.ProfileId);
								var displayName = profile?.Name ?? conversation.ProfileName;
								var photoUrl = profile?.PhotoUrl ?? CreateProfilePlaceholder(displayName);
								<button class="conversation-row @(activeConversationId == conversation.ProfileId ? "active" : "")" @onclick="() => OpenConversationAsync(conversation.ProfileId)"><img src="@photoUrl" alt="" /><span class="conversation-copy"><strong>@displayName</strong><span>@(messageDrafts.TryGetValue(conversation.ProfileId, out var draft) && !string.IsNullOrWhiteSpace(draft) ? $"Brouillon : {draft}" : conversation.Messages.LastOrDefault()?.Text ?? "La conversation commence ici")</span></span><span class="conversation-chevron">›</span></button>
							}
						</aside>
						<section class="chat-panel">
							@if (ActiveConversation is not null && ActiveProfile is not null)
							{
								<header class="chat-header"><button class="chat-back" @onclick="CloseConversation" aria-label="Retour aux conversations">←</button><img src="@ActiveProfile.PhotoUrl" alt="" /><div><strong>@ActiveProfile.Name</strong><span>@ActiveProfile.Area · @(ActiveProfile.IsDemo ? "Profil démo" : "Membre 2gether")</span></div><button class="chat-refresh" type="button" @onclick="() => OpenConversationAsync(activeConversationId)" disabled="@isSendingMessage" aria-label="Actualiser la conversation" title="Actualiser la conversation">↻</button></header>
								<details class="chat-person-details" @key="activeConversationId"><summary>Profil de @ActiveProfile.Name <span>@(ActiveProfile.Age > 0 ? $"{ActiveProfile.Age} ans · " : "")@ActiveProfile.Area</span></summary><div class="chat-person-body">
									@if (!string.IsNullOrWhiteSpace(ActiveProfile.About)) { <p>@ActiveProfile.About</p> }
									<dl class="chat-facts">@if (!string.IsNullOrWhiteSpace(ActiveProfile.Occupation)) { <div><dt>Activité</dt><dd>@ActiveProfile.Occupation</dd></div> }@if (!string.IsNullOrWhiteSpace(ActiveProfile.Intent)) { <div><dt>Recherche</dt><dd>@ActiveProfile.Intent</dd></div> }@if (!string.IsNullOrWhiteSpace(ActiveProfile.Languages)) { <div><dt>Langues</dt><dd>@ActiveProfile.Languages</dd></div> }@if (!string.IsNullOrWhiteSpace(ActiveProfile.Lifestyle)) { <div><dt>Mode de vie</dt><dd>@ActiveProfile.Lifestyle</dd></div> }</dl>
									<div class="profile-interests">@foreach (var interest in ActiveProfile.Interests) { <span class="profile-interest @(SelectedAffinityTopicIds.Contains(interest) ? "shared" : "")">@interest</span> }</div>
									@if (chatProfilePhotos.Count > 0) { <div class="chat-photo-strip">@foreach (var photo in chatProfilePhotos) { <a href="@photo.DataUrl" target="_blank" rel="noopener" aria-label="Agrandir une photo de @ActiveProfile.Name"><img src="@photo.DataUrl" alt="Photo de @ActiveProfile.Name" loading="lazy" /></a> }</div> }
									@if (ActiveProfile.PrivatePhotoCount > 0 && !chatProfilePhotos.Any(photo => photo.Visibility == 1)) { <button type="button" class="photo-request-button" @onclick="() => RequestPrivatePhotoAccessAsync(activeConversationId)" disabled="@ActiveProfile.HasPendingPhotoRequest">@(ActiveProfile.HasPendingPhotoRequest ? "Accès aux photos en attente" : "Demander les photos privées")</button> }
								</div></details>
								@if (SharedChatInterests.Any()) { <div class="chat-common-ground"><strong>En commun</strong>@foreach (var interest in SharedChatInterests) { <span class="profile-interest shared">@interest</span> }</div> }
								@foreach (var request in state.PhotoAccessRequests.Where(request => request.RequesterId == activeConversationId && !request.IsGranted)) { <div class="chat-access-request"><p><strong>@ActiveProfile.Name</strong> souhaite voir tes photos privées.</p><div><button type="button" disabled="@isRespondingToPhotoRequest" @onclick="() => RespondToChatPhotoRequestAsync(request.Id, true)">Autoriser</button><button type="button" disabled="@isRespondingToPhotoRequest" @onclick="() => RespondToChatPhotoRequestAsync(request.Id, false)">Refuser</button></div></div> }
								<div class="chat-messages" role="log" aria-live="polite">@if (ActiveConversation.Messages.Count == 0) { <div class="chat-start"><span class="chat-start-heart">♥</span><strong>Le début d'une conversation</strong><p>@(isAuthenticated ? "Écris le premier message pour faire connaissance." : "Les messages de cette démo restent sur cet appareil.")</p></div> }@foreach (var message in ActiveConversation.Messages) { <div class="message-bubble @(message.IsMine ? "mine" : "theirs")"><p>@message.Text</p><time>@message.SentAt.ToString("HH:mm")</time></div> }</div>
								@if (ActiveConversation.Messages.Count == 0 && string.IsNullOrWhiteSpace(messageText)) { <div class="chat-starters">@foreach (var interest in SharedChatInterests.Take(2)) { <button type="button" @onclick="() => SuggestMessage(interest)">Parler de @interest</button> }</div> }
								@if (!string.IsNullOrWhiteSpace(chatError)) { <p class="chat-error" role="alert">@chatError</p> }
								<form class="message-composer" @onsubmit="SendMessageAsync" @onsubmit:preventDefault><label class="sr-only" for="message-text">Ton message</label><input id="message-text" @bind="messageText" @bind:event="oninput" @bind:after="RememberMessageDraft" placeholder="Écris un petit mot..." maxlength="2000" disabled="@isSendingMessage" /><button type="submit" aria-label="Envoyer le message" disabled="@(isSendingMessage || string.IsNullOrWhiteSpace(messageText))"><span aria-hidden="true">↑</span></button></form>
							}
							else { <div class="chat-placeholder"><span class="placeholder-mark">&</span><h3>Une belle rencontre commence par un mot.</h3><p>Choisis une conversation, ou découvre les profils près de toi.</p><button class="text-button" @onclick="ShowDiscover">Explorer les profils <span aria-hidden="true">→</span></button></div> }
						</section>
					</div><p class="demo-disclaimer">@(isAuthenticated ? "Les conversations sont enregistrées sur ton compte 2gether." : "Démo locale : aucune conversation n'est envoyée à une autre personne.")</p>
				</section>
			}
			else
			{
				<section class="my-profile-view"><header class="subpage-heading"><p class="eyebrow">FAIS CONNAISSANCE AVEC TOI</p><h1>Ton profil.</h1><p>Quelques détails pour trouver des gens qui te ressemblent.</p><div class="profile-header-actions"><button class="preview-profile-button" type="button" @onclick="ToggleProfilePreview">@(showProfilePreview ? "Fermer l'aperçu" : "Aperçu visiteur") <span aria-hidden="true">↗</span></button>@if (isAuthenticated) { <a class="preview-profile-button" href="/passkeys">Gérer mes passkeys</a><button class="signout-button" type="button" @onclick="SignOutAsync">Se déconnecter</button> }</div></header>
					<form class="profile-form" @onsubmit="SaveProfileAsync" @onsubmit:preventDefault>
						<div class="form-section-title"><span class="form-step">01</span><div><h2>Les présentations</h2><p>Tu peux modifier ces infos à tout moment.</p></div></div>
						<div class="form-grid">
							<label class="form-field"><span>Ton prénom</span><input @bind="state.Name" maxlength="32" /></label><label class="form-field"><span>Ton âge</span><input type="number" @bind="state.Age" min="18" max="99" /></label>
							<label class="form-field"><span>Ta ville ou ton quartier</span><input @bind="state.City" maxlength="60" /></label><label class="form-field"><span>Ton métier</span><input @bind="state.Occupation" maxlength="60" placeholder="Ex. architecte, infirmière..." /></label>
							<label class="form-field"><span>Études ou formation</span><input @bind="state.Education" maxlength="80" /></label><label class="form-field"><span>Ton intention</span><select @bind="state.Intent"><option>Une relation sincère</option><option>Faire de belles rencontres</option><option>Voir où la vie mène</option></select></label>
							<label class="form-field form-field-wide"><span>Quelques mots sur toi</span><textarea @bind="state.About" maxlength="600" rows="4" placeholder="Tes envies, ton quotidien, ce qui te fait rire..."></textarea></label>
							<label class="form-field"><span>Langues parlées</span><input @bind="state.Languages" maxlength="100" placeholder="Français, anglais..." /></label><label class="form-field"><span>Ton style de vie</span><input @bind="state.Lifestyle" maxlength="100" placeholder="Sport, sorties, calme..." /></label>
							<label class="form-field form-field-wide"><span>Ce que tu recherches</span><input @bind="state.LookingFor" maxlength="140" /></label>
						</div>
						<section class="avatar-editor"><div class="form-section-title"><span class="form-step">02</span><div><h2>Photo de profil</h2><p>Choisis la photo principale de ton profil.</p></div></div><div class="avatar-editor-row">@if (!string.IsNullOrWhiteSpace(state.AvatarDataUrl)) { <img class="avatar-preview" src="@state.AvatarDataUrl" alt="Ta photo de profil" /> } else { <span class="avatar-placeholder">@(string.IsNullOrWhiteSpace(state.Name) ? "?" : state.Name[..1].ToUpperInvariant())</span> }<label class="photo-upload-button">@(state.AvatarDataUrl is null ? "Ajouter une photo" : "Changer la photo")<InputFile accept="image/jpeg,image/png,image/webp" OnChange="UploadAvatarAsync" /></label>@if (state.AvatarDataUrl is not null) { <button class="photo-remove-button" type="button" @onclick="RemoveAvatarAsync">Retirer</button> }</div></section>

						<section class="photo-library-section"><div class="form-section-title"><span class="form-step">03</span><div><h2>Mes bibliothèques de photos</h2><p>Tu choisis quelles photos montrer et à qui.</p></div></div>
							<div class="photo-library-tabs" role="tablist" aria-label="Bibliothèques de photos"><button type="button" role="tab" aria-selected="@(activePhotoLibrary == "public")" class="@(activePhotoLibrary == "public" ? "active" : "")" @onclick="SelectPublicPhotoLibrary">Publique <span>@state.PublicPhotos.Count</span></button><button type="button" role="tab" aria-selected="@(activePhotoLibrary == "private")" class="@(activePhotoLibrary == "private" ? "active" : "")" @onclick="SelectPrivatePhotoLibrary">Privée <span>@state.PrivatePhotos.Count</span></button></div>
							<div class="photo-library-toolbar"><p>@(activePhotoLibrary == "public" ? "Visible dans l'aperçu public du profil." : "Visible uniquement après avoir accordé une demande.")</p><label class="photo-upload-button">Ajouter des photos<InputFile accept="image/jpeg,image/png,image/webp" multiple OnChange="AddLibraryPhotosAsync" /></label></div>
							@if (ActivePhotoLibrary.Any())
							{
								<div class="owner-photo-grid">@foreach (var photo in ActivePhotoLibrary) { <figure class="owner-photo" @key="photo.Id"><img src="@photo.DataUrl" alt="Photo de la bibliothèque @(activePhotoLibrary == "public" ? "publique" : "privée")" /><button type="button" aria-label="Supprimer cette photo" @onclick="() => RemoveLibraryPhotoAsync(photo.Id)">×</button></figure> }</div>
							}
							else { <div class="photo-library-empty">Aucune photo dans cette bibliothèque.</div> }
							<p class="photo-library-limit">@(isAuthenticated ? "Jusqu'à 4 photos par bibliothèque. Les images sont redimensionnées et leurs métadonnées sont supprimées sur le serveur." : "Jusqu'à 4 photos par bibliothèque. Les images sont redimensionnées et enregistrées sur cet appareil.")</p>
						</section>
						<section class="gps-section"><div class="gps-heading"><span class="gps-icon"><span class="location-pin"></span></span><div><h2>Ma position GPS</h2><p>@(state.Latitude is null ? "Pas encore définie" : $"Enregistrée · précision ±{state.LocationAccuracyMeters:0} m")</p></div></div>
							<p class="gps-explanation">@(isAuthenticated ? "Avec ton autorisation, les coordonnées exactes sont enregistrées sur ton compte. Les autres membres voient uniquement une zone approximative." : "Ton navigateur demandera l'autorisation. Les coordonnées exactes restent uniquement sur cet appareil dans cette démo.")</p>
							@if (state.Latitude is not null && state.Longitude is not null) { <code class="gps-coordinates">@state.Latitude.Value.ToString("F5"), @state.Longitude.Value.ToString("F5")</code> }
							<div class="gps-actions"><button class="gps-button" type="button" @onclick="RequestLocationAsync" disabled="@isLocating">@(isLocating ? "Recherche en cours..." : state.Latitude is null ? "Autoriser l'accès à ma position" : "Actualiser ma position")</button>@if (state.Latitude is not null) { <button class="gps-clear-button" type="button" @onclick="ClearLocationAsync">Supprimer</button> }</div>
							@if (!string.IsNullOrWhiteSpace(locationFeedback)) { <p class="gps-feedback" role="status">@locationFeedback</p> }
						</section>
						<div class="form-section-title interests-title"><span class="form-step">04</span><div><h2>Ce qui te ressemble</h2><p>Les intérêts que tu aimerais partager.</p></div></div>
						<div class="profile-interest-list">@foreach (var interest in AllInterests) { <button type="button" class="interest-chip @(state.Interests.Contains(interest) ? "active" : "")" @onclick="() => ToggleInterestAsync(interest)">@interest</button> }</div>
						<div class="privacy-callout"><span class="privacy-mark">i</span><div><strong>Ta vie privée d'abord</strong><p>@(isAuthenticated ? "Ta position exacte n'est pas partagée avec les autres membres. Les zones et les distances affichées sont approximatives." : "Ta position exacte reste sur cet appareil. Les kilomètres affichés sont arrondis et les profils sont des exemples.")</p></div></div>
						<button class="save-profile-button" type="submit">Enregistrer mon profil <span aria-hidden="true">→</span></button>
					</form>
					@if (showProfilePreview)
					{
						<section class="profile-gallery-preview"><div class="preview-heading"><div><p class="eyebrow">APERÇU CÔTÉ VISITEUR</p><h2>@state.Name, @state.Age</h2></div><span class="preview-local-badge">Simulation sur cet appareil</span></div>
							<h3>Photos publiques <span>@state.PublicPhotos.Count</span></h3>
							@if (state.AvatarDataUrl is not null || state.PublicPhotos.Count > 0) { <div class="visitor-photo-grid">@if (state.AvatarDataUrl is not null) { <img src="@state.AvatarDataUrl" alt="Photo de profil publique" /> }@foreach (var photo in state.PublicPhotos) { <img src="@photo.DataUrl" alt="Photo publique" /> }</div> } else { <p class="photo-library-empty">Ajoute une photo publique pour la voir dans cet aperçu.</p> }
							@if (state.PrivatePhotos.Count > 0)
							{
								<h3 class="private-preview-title">Photos privées <span>@(HasDemoPrivateAccess ? state.PrivatePhotos.Count : "Verrouillées")</span></h3>
								@if (HasDemoPrivateAccess) { <div class="visitor-photo-grid">@foreach (var photo in state.PrivatePhotos) { <img src="@photo.DataUrl" alt="Photo privée autorisée" /> }</div> }
								else { <div class="private-lock-panel"><span aria-hidden="true">▣</span><p>Ces photos ne sont pas publiques. Le propriétaire doit accepter une demande.</p><button type="button" class="photo-request-button" @onclick="RequestDemoPhotoAccessAsync" disabled="@HasPendingDemoRequest">@(HasPendingDemoRequest ? "Demande envoyée" : "Demander l'accès")</button></div> }
							}
							@if (state.PhotoAccessRequests.Any(request => !request.IsGranted))
							{
								<div class="photo-request-inbox"><h3>Demandes d'accès</h3>@foreach (var request in state.PhotoAccessRequests.Where(request => !request.IsGranted)) { <div class="photo-request-row"><span><strong>@request.RequesterName</strong><small>Demande l'accès aux photos privées</small></span><button type="button" @onclick="() => GrantDemoPhotoAccessAsync(request.Id)">Autoriser</button></div> }</div>
							}
							<p class="demo-disclaimer">Aperçu et demandes simulés localement. Ils ne sont pas visibles par d'autres appareils.</p>
						</section>
					}
					<p class="demo-disclaimer">Profil conservé uniquement sur cet appareil pour cette démonstration.</p>
				</section>
			}
		</div>
	</main>

	<nav class="mobile-nav" aria-label="Navigation principale"><button class="mobile-nav-item @(activePage is "discover" or "profile-detail" ? "selected" : "")" @onclick="ShowDiscover"><span class="mobile-icon discover-symbol"></span><span>Découvrir</span></button><button class="mobile-nav-item @(activePage == "map" ? "selected" : "")" @onclick="ShowMap"><span class="mobile-icon map-symbol"></span><span>Carte</span></button><button class="mobile-nav-item @(activePage == "messages" ? "selected" : "")" @onclick="ShowMessages"><span class="mobile-icon messages-symbol"></span><span>Messages</span>@if (state.Conversations.Count > 0) { <span class="mobile-badge">@state.Conversations.Count</span> }</button><button class="mobile-nav-item @(activePage == "profile" ? "selected" : "")" @onclick="ShowProfile"><span class="mobile-icon profile-symbol"></span><span>Profil</span></button></nav>
	@if (!string.IsNullOrWhiteSpace(toastMessage)) { <div class="toast-message" role="status"><span aria-hidden="true">♥</span>@toastMessage<button @onclick="DismissToast" aria-label="Fermer">×</button></div> }
	}
</div>

@code {
