	{
		if (SelectedAffinityTopicIds.Count == 0)
		{
			onboardingFeedback = "Choisis au moins une passion pour continuer.";
			return;
		}
		onboardingStep = 2;
		onboardingFeedback = "";
		if (!await EnsureRemoteProfileAsync(false)) return;
	}
	private async Task CompleteOnboardingAsync()
	{
		if (isSubmittingRegistration) return;
		profileValidationAttempted = true;
		onboardingFeedback = "";
		if (await FocusFirstRegistrationIssueAsync("age", "gender", "orientation", "biography")) return;
		state.Age = int.Parse(registrationAge);
		isSubmittingRegistration = true;
		try
		{
		state.OnboardingComplete = true;
		if (!await EnsureRemoteProfileAsync(true))
		{
			state.OnboardingComplete = false;
			return;
		}
		if (state.Latitude is double latitude && state.Longitude is double longitude)
		{
			using var locationResponse = await Http.PostAsJsonAsync("/api/me/location", new { Latitude = latitude, Longitude = longitude, AccuracyMeters = state.LocationAccuracyMeters ?? 0 });
			if (!locationResponse.IsSuccessStatusCode) onboardingFeedback = "Le profil est enregistré, mais la position n'a pas pu être synchronisée.";
		}
		activePage = "discover";
		onboardingFeedback = "";
		await LoadNearbyProfilesAsync();
		}
		catch (HttpRequestException) { state.OnboardingComplete = false; onboardingFeedback = "Connexion interrompue. Tes réponses sont conservées ; réessaie dans un instant."; }
		finally { isSubmittingRegistration = false; }
	}
	private async Task RestoreAuthenticatedSessionAsync()
	{
		try
		{
			using var accountResponse = await Http.GetAsync("/api/session");
			if (!accountResponse.IsSuccessStatusCode) return;
			var account = await accountResponse.Content.ReadFromJsonAsync<SessionResponse>();
			if (account?.AccountSuspended == true)
			{
				accountSuspended = true;
				return;
			}
			if (account?.IsAuthenticated != true) return;
			isAuthenticated = true;
			currentUserId = account.UserId;
			state.AccountEmail = account.Email;
			await LoadRemoteProfileAsync();
			if (!state.OnboardingComplete && onboardingStep == 0) onboardingStep = 1;
			await JS.InvokeVoidAsync("localStorage.removeItem", StorageKey);
		}
		catch (HttpRequestException)
		{
			isAuthenticated = false;
			state.OnboardingComplete = false;
		}
	}
	private async Task LoadRemoteProfileAsync()
	{
		using var response = await Http.GetAsync("/api/me/profile");
		if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
		{
			state.OnboardingComplete = false;
			return;
		}
		if (!response.IsSuccessStatusCode) return;
		var profile = await response.Content.ReadFromJsonAsync<OwnProfileResponse>();
		if (profile is null) return;
		currentUserId = profile.UserId;
		state.AccountEmail = profile.Email;
		state.Name = profile.DisplayName;
		state.Age = profile.Age;
		state.Gender = profile.Gender;
		state.SexualOrientation = profile.SexualOrientation;
		state.About = profile.Biography;
		state.City = profile.City;
		state.Occupation = profile.Occupation;
		state.Education = profile.Education;
		state.Languages = profile.Languages;
		state.Lifestyle = profile.Lifestyle;
		state.LookingFor = profile.LookingFor;
		state.Intent = profile.Intent;
		state.Interests = profile.Interests.ToList();
		state.AffinityReasonIds = profile.AffinityReasonIds.ToList();
		state.Latitude = profile.Latitude;
		state.Longitude = profile.Longitude;
		state.LocationAccuracyMeters = profile.LocationAccuracyMeters;
		state.OnboardingComplete = profile.OnboardingComplete;
		await LoadRemotePhotosAsync();
		if (profile.OnboardingComplete) await LoadNearbyProfilesAsync();
	}
	private async Task LoadRemotePhotosAsync()
	{
		using var response = await Http.GetAsync("/api/me/photos");
		if (!response.IsSuccessStatusCode) return;
		var photos = await response.Content.ReadFromJsonAsync<List<ProfilePhotoResponse>>() ?? [];
		var avatar = photos.FirstOrDefault(photo => photo.IsAvatar);
		state.AvatarDataUrl = avatar?.Url;
		state.AvatarPhotoId = avatar?.Id.ToString() ?? "";
		state.PublicPhotos = photos.Where(photo => !photo.IsAvatar && photo.Visibility == 0).Select(photo => new ProfilePhoto { Id = photo.Id.ToString(), DataUrl = photo.Url, Visibility = photo.Visibility }).ToList();
		state.PrivatePhotos = photos.Where(photo => photo.Visibility == 1).Select(photo => new ProfilePhoto { Id = photo.Id.ToString(), DataUrl = photo.Url, Visibility = photo.Visibility }).ToList();
	}
	private async Task LoadNearbyProfilesAsync()
	{
		using var response = await Http.GetAsync("/api/profiles?radiusKm=100");
		if (!response.IsSuccessStatusCode) return;
		var remoteProfiles = await response.Content.ReadFromJsonAsync<List<PublicProfileResponse>>() ?? [];
		profiles = remoteProfiles.Select(ToProfile).ToList();
	}
	private static Profile ToProfile(PublicProfileResponse profile) => new()
		{
			Id = profile.UserId,
			Name = profile.DisplayName,
			Age = profile.Age,
			Gender = profile.Gender,
			SexualOrientation = profile.SexualOrientation,
			Occupation = profile.Occupation,
			Education = profile.Education,
			Area = profile.City,
			DemoDistanceKm = profile.DistanceKm,
			Latitude = profile.MapLatitude,
			Longitude = profile.MapLongitude,
			PhotoUrl = profile.AvatarUrl ?? CreateProfilePlaceholder(profile.DisplayName),
			PublicPhotoCount = profile.PublicPhotoCount,
			PrivatePhotoCount = profile.PrivatePhotoCount,
			HasPendingPhotoRequest = profile.HasPendingPhotoRequest,
			Bio = profile.Biography,
			About = profile.Biography,
			Languages = profile.Languages,
			Lifestyle = profile.Lifestyle,
			Intent = profile.Intent,
			LookingFor = profile.LookingFor,
			Interests = profile.Interests,
			IsDemo = false
		};
	private static string CreateProfilePlaceholder(string displayName)
	{
		var initial = System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(displayName) ? "?" : displayName[..1].ToUpperInvariant());
		var svg = $"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 480'><rect width='400' height='480' fill='#e8eee8'/><circle cx='200' cy='170' r='78' fill='#cad9cb'/><path d='M55 440c7-112 60-165 145-165s138 53 145 165' fill='#cad9cb'/><text x='200' y='195' text-anchor='middle' font-family='Georgia,serif' font-size='68' fill='#355b46'>{initial}</text></svg>";
		return $"data:image/svg+xml,{Uri.EscapeDataString(svg)}";
	}
	private async Task<bool> EnsureRemoteProfileAsync(bool onboardingComplete)
	{
		if (!isAuthenticated) return false;
		var request = new ProfileUpsertRequest(state.Name, state.Age, state.Gender, state.SexualOrientation, state.About, state.City, state.Occupation, state.Education, state.Languages, state.Lifestyle, state.LookingFor, state.Intent, state.Interests, state.AffinityReasonIds, onboardingComplete);
		using var response = await Http.PutAsJsonAsync("/api/me/profile", request);
		if (response.IsSuccessStatusCode) return true;
		onboardingFeedback = await ReadApiErrorAsync(response, "Impossible d'enregistrer le profil sur le serveur.");
		return false;
	}
	private static async Task<string> ReadApiErrorAsync(HttpResponseMessage response, string fallback)
	{
		try
		{
			using var document = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
			if (document.RootElement.TryGetProperty("detail", out var detail) && detail.ValueKind == JsonValueKind.String) return detail.GetString() ?? fallback;
			if (document.RootElement.TryGetProperty("title", out var title) && title.ValueKind == JsonValueKind.String) return title.GetString() ?? fallback;
		}
		catch (JsonException) { }
		return fallback;
	}
	private Profile? FindProfile(string id) => profiles.FirstOrDefault(profile => profile.Id == id) ?? SampleProfiles.FirstOrDefault(profile => profile.Id == id);
	private string AffinityLabel(Profile profile) => profile.Interests.Any(SelectedAffinityTopicIds.Contains) ? $"{AffinityPercent(profile)}% en commun" : "À découvrir";
	private int AffinityPercent(Profile profile)
	{
		var selectedTopics = SelectedAffinityTopicIds;
		return selectedTopics.Count == 0 ? 0 : (int)Math.Round((double)profile.Interests.Count(selectedTopics.Contains) / selectedTopics.Count * 100);
	}

	private async Task ToggleInterestAsync(string interest)
	{
		if (!state.Interests.Remove(interest))
		{
			if (SelectedAffinityTopicIds.Count >= 10) { toastMessage = "Tu peux choisir au maximum 10 passions."; return; }
			state.Interests.Add(interest);
		}
		await SaveStateAsync();
	}
	private async Task ToggleAffinityReasonAsync(string reasonId)
	{
		if (!AffinityReasonCatalog.Reasons.Any(reason => reason.Id == reasonId)) return;
		if (!state.AffinityReasonIds.Remove(reasonId))
		{
			var topicId = AffinityReasonCatalog.Reasons.First(reason => reason.Id == reasonId).TopicId;
			if (!SelectedAffinityTopicIds.Contains(topicId) && SelectedAffinityTopicIds.Count >= 10) { toastMessage = "Tu peux choisir au maximum 10 passions."; return; }
			state.AffinityReasonIds.Add(reasonId);
		}
		await SaveStateAsync();
	}
