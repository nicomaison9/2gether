	private List<ProfilePhoto> ActivePhotoLibrary => activePhotoLibrary == "public" ? state.PublicPhotos : state.PrivatePhotos;
	private int SelectedAffinityCount => state.Interests.Count + state.AffinityReasonIds.Count;
	private HashSet<string> SelectedAffinityTopicIds => state.Interests.Concat(state.AffinityReasonIds.Select(id => AffinityReasonCatalog.Reasons.FirstOrDefault(reason => reason.Id == id)?.TopicId).OfType<string>()).ToHashSet();
	private IEnumerable<AffinityReason> FilteredAffinityReasons => AffinityReasonCatalog.Reasons.Where(reason => (selectedAffinityCategory == "Toutes les catégories" || reason.Category == selectedAffinityCategory) && (string.IsNullOrWhiteSpace(affinitySearch) || reason.Text.Contains(affinitySearch.Trim(), StringComparison.OrdinalIgnoreCase) || reason.Category.Contains(affinitySearch.Trim(), StringComparison.OrdinalIgnoreCase))).OrderByDescending(reason => state.AffinityReasonIds.Contains(reason.Id));
	private int FilteredAffinityReasonCount => FilteredAffinityReasons.Count();
	private int VisibleAffinityReasonCount => Math.Min(affinityDisplayLimit, FilteredAffinityReasonCount);
	private IEnumerable<AffinityReason> VisibleAffinityReasons => FilteredAffinityReasons.Take(affinityDisplayLimit);
	private IEnumerable<AffinityTopic> FilteredOnboardingTopics => AffinityReasonCatalog.Topics.Where(topic => (onboardingTopicCategory == "Toutes les catégories" || topic.Category == onboardingTopicCategory) && (string.IsNullOrWhiteSpace(onboardingTopicSearch) || topic.Id.Contains(onboardingTopicSearch.Trim(), StringComparison.OrdinalIgnoreCase) || topic.Activity.Contains(onboardingTopicSearch.Trim(), StringComparison.OrdinalIgnoreCase) || topic.Category.Contains(onboardingTopicSearch.Trim(), StringComparison.OrdinalIgnoreCase)));
	private IEnumerable<AffinityTopic> VisibleOnboardingTopics => FilteredOnboardingTopics.Take(onboardingTopicLimit);
	private bool HasDemoPrivateAccess => state.PhotoAccessRequests.Any(request => request.IsGranted);
	private bool HasPendingDemoRequest => state.PhotoAccessRequests.Any(request => !request.IsGranted);
	private string DistanceOriginLabel => isAuthenticated ? "Distance approximative" : state.Latitude is null ? "Distance de démonstration" : "Depuis ta position GPS · profil exemple";
	private IEnumerable<Profile> VisibleProfiles => profiles.Where(profile => !state.HiddenProfileIds.Contains(profile.Id) && DistanceFromUser(profile) <= state.RadiusKm).OrderByDescending(AffinityPercent).ThenBy(DistanceFromUser);
	private Conversation? ActiveConversation => state.Conversations.FirstOrDefault(item => item.ProfileId == activeConversationId);
	private Profile? ActiveProfile
	{
		get
		{
			var profile = FindProfile(activeConversationId);
			if (profile is not null) return profile;
			var conversation = ActiveConversation;
			return conversation is null ? null : new Profile { Id = conversation.ProfileId, Name = conversation.ProfileName, Area = conversation.Area, DemoDistanceKm = conversation.DistanceKm, PhotoUrl = conversation.PhotoUrl, IsDemo = !isAuthenticated };
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			if (LoginAfterConfirmation) accountMode = "existing";
			try
			{
				var options = await Http.GetFromJsonAsync<RegistrationEmailOptions>("/api/registration-options");
				localEmailDelivery = options?.LocalEmailDelivery == true;
			}
			catch (HttpRequestException) { }
			try
			{
				var savedState = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
				if (!string.IsNullOrWhiteSpace(savedState)) state = JsonSerializer.Deserialize<DemoState>(savedState) ?? new DemoState();
			}
			catch (JsonException) { state = new DemoState(); }
			state.OnboardingComplete = false;
			state.Interests ??= [];
			state.LikedProfileIds ??= [];
			state.HiddenProfileIds ??= [];
			state.Conversations ??= [];
			state.PublicPhotos ??= [];
			state.PrivatePhotos ??= [];
			state.PhotoAccessRequests ??= [];
			state.AffinityReasonIds ??= [];
			if (!ProfileDisplayModes.Contains(state.ProfileDisplayMode)) state.ProfileDisplayMode = "medium";
			await RestoreAuthenticatedSessionAsync();
			if (!isAuthenticated)
			{
				var displayMode = state.ProfileDisplayMode;
				state = new DemoState { Name = "", Age = 18, Interests = [], ProfileDisplayMode = displayMode };
				onboardingStep = 0;
			}
			StateHasChanged();
			messagePollingTask = PollMessagesAsync(messagePollingCancellation.Token);
		}

		if (scrollChatToBottom && activePage == "messages")
		{
			scrollChatToBottom = false;
			await JS.InvokeVoidAsync("chatViewport.scrollToLatest");
		}
		if (activePage == "map")
		{
			mapReference ??= DotNetObjectReference.Create(this);
			var profiles = VisibleProfiles.Select(profile => new { id = profile.Id, name = profile.Name, area = profile.Area, latitude = profile.Latitude, longitude = profile.Longitude, distanceKm = DistanceFromUser(profile) }).ToArray();
			var currentLocation = state.Latitude is double latitude && state.Longitude is double longitude ? new { latitude, longitude } : null;
			await JS.InvokeVoidAsync("profileMap.render", "profile-map", profiles, currentLocation, mapReference);
		}
		else if (mapReference is not null)
		{
			await JS.InvokeVoidAsync("profileMap.dispose", "profile-map");
			mapReference.Dispose();
			mapReference = null;
		}
	}

