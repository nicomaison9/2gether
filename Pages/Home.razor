	private async Task ResendVerificationAsync()
	{
		if (isSubmittingRegistration || DateTimeOffset.UtcNow < verificationResendAt) return;
		accountValidationAttempted = false;
		visitedRegistrationFields.Add("email");
		if (await FocusFirstRegistrationIssueAsync("email")) return;
		isSubmittingRegistration = true;
		try
		{
			using var response = await Http.PostAsJsonAsync("/api/auth/resendConfirmationEmail", new { Email = state.AccountEmail.Trim() });
			onboardingFeedback = response.IsSuccessStatusCode ? "Si cette adresse correspond à un compte à vérifier, un nouveau lien a été demandé." : response.StatusCode == System.Net.HttpStatusCode.TooManyRequests ? "Trop de demandes. Patiente une minute avant de réessayer." : "Le message n'a pas pu être envoyé. Réessaie dans un instant.";
			verificationResendAt = DateTimeOffset.UtcNow.AddSeconds(30);
		}
		catch (HttpRequestException) { onboardingFeedback = "Le serveur est indisponible. Réessaie dans un instant."; }
		finally { isSubmittingRegistration = false; }
	}
