	private IEnumerable<(string Text, bool Complete)> RegistrationChecks(string field) => field switch
	{
		"email" => [("Écris une adresse e-mail complète, comme lea@exemple.fr.", System.Net.Mail.MailAddress.TryCreate(state.AccountEmail.Trim(), out var address) && address.Address == state.AccountEmail.Trim())],
		"password" when accountMode == "existing" => [("Entre le mot de passe que tu as choisi à l'inscription.", onboardingPassword.Length > 0)],
		"password" => [("Au moins 10 caractères.", onboardingPassword.Length >= 10), ("Au moins un chiffre (0 à 9).", onboardingPassword.Any(character => character is >= '0' and <= '9')), ("Au moins une lettre minuscule (a à z).", onboardingPassword.Any(character => character is >= 'a' and <= 'z'))],
		"name" => [("Écris le prénom ou le surnom que les autres verront (32 caractères maximum).", state.Name.Trim().Length is > 0 and <= 32)],
		"age" => [("Indique ton âge en années, par exemple 28. Il faut avoir au moins 18 ans (120 maximum).", int.TryParse(registrationAge, out var age) && age is >= 18 and <= 120)],
		"gender" => [("Choisis une réponse, ou « Je préfère ne pas préciser ».", !string.IsNullOrWhiteSpace(state.Gender))],
		"orientation" => [("Choisis une réponse, ou « Je préfère ne pas préciser ».", !string.IsNullOrWhiteSpace(state.SexualOrientation))],
		"biography" => [("Écris une phrase sur toi. Exemple : « J'aime les balades et discuter autour d'un café. »", !string.IsNullOrWhiteSpace(state.About))],
		_ => []
	};
	private string RegistrationTitle(string field) => field switch { "email" => "Pour retrouver ton compte", "password" => "Ton mot de passe", "name" => "Le nom visible sur ton profil", "age" => "Ton âge, pas ton année de naissance", "gender" => "Comment tu te définis", "orientation" => "Les personnes qui peuvent t'attirer", _ => "Quelques mots pour faire connaissance" };
	private bool RegistrationHasError(string field) => (visitedRegistrationFields.Contains(field) || (field is "email" or "password" or "name" ? accountValidationAttempted : profileValidationAttempted)) && RegistrationChecks(field).Any(check => !check.Complete);
	private string RegistrationInvalid(string field) => RegistrationHasError(field) ? "true" : "false";
	private string? RegistrationDescription(string field) => activeRegistrationField == field || RegistrationHasError(field) ? $"registration-help-{field}" : null;
	private void ShowRegistrationHelp(string field) => activeRegistrationField = field;
	private void LeaveRegistrationField(string field) => visitedRegistrationFields.Add(field);
	private void ToggleRegistrationPassword() { showRegistrationPassword = !showRegistrationPassword; activeRegistrationField = "password"; }
	private void HandleRegistrationKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") activeRegistrationField = ""; }
	private RenderFragment RegistrationHelp(string field) => @<div id="@($"registration-help-{field}")" class="registration-help @(activeRegistrationField == field ? "is-open" : "") @(RegistrationHasError(field) ? "has-error" : "")" hidden="@(activeRegistrationField != field && !RegistrationHasError(field))" role="status" aria-live="polite"><strong>@RegistrationTitle(field)</strong><ul>@foreach (var check in RegistrationChecks(field)) { <li class="@(check.Complete ? "complete" : "missing")"><span aria-hidden="true">@(check.Complete ? "✓" : "○")</span><span>@check.Text @(check.Complete ? "C'est bon." : "")</span></li> }</ul></div>;
	private async Task<bool> FocusFirstRegistrationIssueAsync(params string[] fields)
	{
		var first = fields.FirstOrDefault(field => RegistrationChecks(field).Any(check => !check.Complete));
		if (first is null) return false;
		activeRegistrationField = first;
		StateHasChanged();
		await JS.InvokeVoidAsync("registrationGuidance.focusField", $"registration-{first}");
		return true;
	}
