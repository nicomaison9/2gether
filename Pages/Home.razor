	private async Task ContinueFromAccountAsync()
	{
		if (isSubmittingRegistration) return;
		state.AccountEmail = state.AccountEmail.Trim();
		state.Name = state.Name.Trim();
		accountValidationAttempted = true;
		onboardingFeedback = "";
		if (await FocusFirstRegistrationIssueAsync(accountMode == "create" ? ["email", "password", "name"] : ["email", "password"])) return;

		isSubmittingRegistration = true;
		try
		{
			if (accountMode == "create")
			{
				using var registerResponse = await Http.PostAsJsonAsync("/api/auth/register", new { Email = state.AccountEmail, Password = onboardingPassword });
				if (!registerResponse.IsSuccessStatusCode)
				{
					if (registerResponse.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable)
					{
						awaitingEmailConfirmation = true;
						onboardingPassword = "";
						onboardingFeedback = "L'envoi n'a pas abouti. Ton compte reste inactif ; tu peux réessayer avec « Renvoyer le lien ».";
						return;
					}
					onboardingFeedback = await ReadApiErrorAsync(registerResponse, "Impossible de créer le compte. Vérifie l'adresse et le mot de passe (10 caractères et un chiffre minimum).");
					return;
				}
				awaitingEmailConfirmation = true;
				verificationResendAt = DateTimeOffset.UtcNow.AddSeconds(30);
				onboardingPassword = "";
				onboardingFeedback = "";
				return;
			}

			using var loginResponse = await Http.PostAsJsonAsync("/api/auth/login?useCookies=true", new { Email = state.AccountEmail, Password = onboardingPassword });
			if (!loginResponse.IsSuccessStatusCode)
			{
				onboardingFeedback = loginResponse.StatusCode == System.Net.HttpStatusCode.TooManyRequests ? "Trop de tentatives. Patiente une minute avant de réessayer." : "Connexion impossible. Vérifie tes identifiants et confirme d'abord ton adresse e-mail. Tu peux demander un nouveau lien ci-dessus.";
				return;
			}

			using var sessionResponse = await Http.GetAsync("/api/session");
			var session = await sessionResponse.Content.ReadFromJsonAsync<SessionResponse>();
			if (session?.AccountSuspended == true)
			{
				accountSuspended = true;
				onboardingPassword = "";
				using var signOutResponse = await Http.PostAsync("/api/session/logout", null);
				if (!signOutResponse.IsSuccessStatusCode)
					onboardingFeedback = "L’accès à ce compte est suspendu. La fermeture de session n’a pas abouti ; recharge la page avant de réessayer.";
				return;
			}
			if (session?.IsAuthenticated != true)
			{
				onboardingFeedback = "La session n’a pas pu être vérifiée. Réessaie de te connecter.";
				return;
			}

			isAuthenticated = true;
			state.AccountMode = accountMode;
			state.OnboardingComplete = false;
			onboardingPassword = "";
			await JS.InvokeVoidAsync("localStorage.removeItem", StorageKey);
			await LoadRemoteProfileAsync();
			if (state.OnboardingComplete)
			{
				activePage = "discover";
				onboardingFeedback = "";
				return;
			}
			if (accountMode == "existing" && string.IsNullOrWhiteSpace(state.Name)) state.Name = state.AccountEmail.Split('@')[0];
			if (onboardingStep == 0) onboardingStep = 1;
			onboardingFeedback = "";
			await EnsureRemoteProfileAsync(false);
		}
		catch (HttpRequestException)
		{
			onboardingFeedback = "Le serveur est indisponible. Réessaie dans un instant.";
		}
		finally { isSubmittingRegistration = false; }
	}
	private async Task LoginWithPasskeyAsync()
	{
		if (isSubmittingRegistration) return;
		isSubmittingRegistration = true;
		onboardingFeedback = "";
		try
		{
			using var optionsResponse = await Http.PostAsync("/api/passkeys/login/options", null);
			if (!optionsResponse.IsSuccessStatusCode)
			{
				onboardingFeedback = optionsResponse.StatusCode == System.Net.HttpStatusCode.TooManyRequests
					? "Trop de tentatives. Patiente une minute avant de réessayer."
					: "La connexion par passkey est indisponible. Réessaie dans un instant.";
				return;
			}

			var ceremony = await optionsResponse.Content.ReadFromJsonAsync<PasskeyStartResponse>();
			if (ceremony is null || string.IsNullOrWhiteSpace(ceremony.OperationId))
			{
				onboardingFeedback = "La demande de connexion n'a pas pu être préparée. Réessaie.";
				return;
			}

			var credential = await JS.InvokeAsync<JsonElement>("passkeys.get", ceremony.Options);
			using var loginResponse = await Http.PostAsJsonAsync("/api/passkeys/login/complete", new { ceremony.OperationId, Credential = credential });
			if (!loginResponse.IsSuccessStatusCode)
			{
				onboardingFeedback = loginResponse.StatusCode == System.Net.HttpStatusCode.TooManyRequests
					? "Trop de tentatives. Patiente une minute avant de réessayer."
					: "Connexion refusée. Vérifie ta passkey et réessaie.";
				return;
			}

			Navigation.NavigateTo("/", forceLoad: true);
		}
		catch (JSException)
		{
			onboardingFeedback = "La passkey a été annulée ou n'est pas prise en charge par cet appareil ou ce navigateur.";
		}
		catch (HttpRequestException)
		{
			onboardingFeedback = "Le serveur est indisponible. Réessaie dans un instant.";
		}
		finally { isSubmittingRegistration = false; }
	}
	private async Task ToggleOnboardingTopicAsync(string topicId)
	{
		if (!AffinityReasonCatalog.Topics.Any(topic => topic.Id == topicId)) return;
		if (!state.Interests.Remove(topicId))
		{
			if (SelectedAffinityTopicIds.Count >= 10)
			{
				onboardingFeedback = "Tu peux choisir au maximum 10 passions.";
				return;
			}
			state.Interests.Add(topicId);
		}
		onboardingFeedback = "";
		await SaveStateAsync();
	}
