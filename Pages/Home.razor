	private async Task OpenConversationAsync(string profileId)
	{
		RememberMessageDraft();
		activeConversationId = profileId;
		messageText = messageDrafts.GetValueOrDefault(profileId, "");
		chatError = "";
		chatProfilePhotos = [];
		if (!isAuthenticated || FindProfile(profileId) is { IsDemo: true }) return;
		try
		{
		using var profileResponse = await Http.GetAsync($"/api/profiles/{Uri.EscapeDataString(profileId)}");
		if (activeConversationId != profileId) return;
		if (profileResponse.IsSuccessStatusCode)
		{
			var remoteProfile = await profileResponse.Content.ReadFromJsonAsync<PublicProfileResponse>();
			if (remoteProfile is not null) { profiles.RemoveAll(item => item.Id == profileId); profiles.Add(ToProfile(remoteProfile)); }
		}
		using var response = await Http.GetAsync($"/api/messages/{Uri.EscapeDataString(profileId)}");
		if (activeConversationId != profileId) return;
		if (!response.IsSuccessStatusCode) { chatError = "Impossible de charger cette conversation. Réessaie avec Actualiser."; return; }
		var messages = await response.Content.ReadFromJsonAsync<List<DirectMessageResponse>>() ?? [];
		var conversation = state.Conversations.FirstOrDefault(item => item.ProfileId == profileId);
		if (conversation is null)
		{
			var profile = FindProfile(profileId);
			conversation = new Conversation { ProfileId = profileId, ProfileName = profile?.Name ?? "Membre 2gether", Area = profile?.Area ?? "", DistanceKm = profile is null ? 0 : DistanceFromUser(profile), PhotoUrl = profile?.PhotoUrl ?? CreateProfilePlaceholder("M") };
			state.Conversations.Add(conversation);
		}
		conversation.Messages = messages.Select(message => new ChatMessage { Text = message.Text, SentAt = message.SentAt.LocalDateTime, IsMine = message.SenderId == currentUserId }).ToList();
		scrollChatToBottom = true;
		using var photoResponse = await Http.GetAsync($"/api/profiles/{Uri.EscapeDataString(profileId)}/photos");
		if (activeConversationId != profileId || !photoResponse.IsSuccessStatusCode) return;
		var photos = await photoResponse.Content.ReadFromJsonAsync<List<ProfilePhotoResponse>>() ?? [];
		chatProfilePhotos = photos.Select(photo => new ProfilePhoto { Id = photo.Id.ToString(), DataUrl = photo.Url, Visibility = photo.Visibility }).ToList();
		await LoadRemotePhotoRequestsAsync();
		}
		catch (HttpRequestException) { if (activeConversationId == profileId) chatError = "Connexion interrompue. Réessaie avec Actualiser."; }
	}
	private async Task PollMessagesAsync(CancellationToken cancellationToken)
	{
		using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
		try
		{
			while (await timer.WaitForNextTickAsync(cancellationToken))
			{
				if (!state.OnboardingComplete && verificationResendAt != default) await InvokeAsync(StateHasChanged);
				if (!isAuthenticated || activePage != "messages" || isSendingMessage) continue;
				try
				{
					var conversation = ActiveConversation;
					if (conversation is null) { await LoadRemoteConversationsAsync(); await InvokeAsync(StateHasChanged); continue; }
					if (ActiveProfile is { IsDemo: true }) continue;
					var userId = currentUserId;
					await LoadRemotePhotoRequestsAsync(cancellationToken);
					if (ActiveConversation != conversation || currentUserId != userId) continue;
					if (ActiveProfile is { HasPendingPhotoRequest: true })
					{
						using var photoResponse = await Http.GetAsync($"/api/profiles/{Uri.EscapeDataString(conversation.ProfileId)}/photos", cancellationToken);
						if (photoResponse.IsSuccessStatusCode && ActiveConversation == conversation)
						{
							var photos = await photoResponse.Content.ReadFromJsonAsync<List<ProfilePhotoResponse>>(cancellationToken) ?? [];
							chatProfilePhotos = photos.Select(photo => new ProfilePhoto { Id = photo.Id.ToString(), DataUrl = photo.Url, Visibility = photo.Visibility }).ToList();
							if (photos.Any(photo => photo.Visibility == 1) && ActiveProfile is { } profile) profile.HasPendingPhotoRequest = false;
						}
					}
					await InvokeAsync(StateHasChanged);
					using var response = await Http.GetAsync($"/api/messages/{Uri.EscapeDataString(conversation.ProfileId)}", cancellationToken);
					if (!response.IsSuccessStatusCode || isSendingMessage || currentUserId != userId || ActiveConversation != conversation || activePage != "messages") continue;
					var messages = await response.Content.ReadFromJsonAsync<List<DirectMessageResponse>>(cancellationToken) ?? [];
					var latest = messages.LastOrDefault();
					var previous = conversation.Messages.LastOrDefault();
					if (latest is null || previous is not null && latest.SentAt.LocalDateTime <= previous.SentAt && latest.Text == previous.Text) continue;
					if (previous is not null && latest.SentAt.LocalDateTime < previous.SentAt) continue;
					var nearLatest = await JS.InvokeAsync<bool>("chatViewport.isNearLatest");
					conversation.Messages = messages.Select(message => new ChatMessage { Text = message.Text, SentAt = message.SentAt.LocalDateTime, IsMine = message.SenderId == currentUserId }).ToList();
					scrollChatToBottom = nearLatest;
					await InvokeAsync(StateHasChanged);
				}
				catch (HttpRequestException) { }
			}
		}
		catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
	}
	public async ValueTask DisposeAsync()
	{
		messagePollingCancellation.Cancel();
		if (messagePollingTask is not null) await messagePollingTask;
		messagePollingCancellation.Dispose();
		mapReference?.Dispose();
	}
	private async Task LoadRemoteConversationsAsync()
	{
		using var response = await Http.GetAsync("/api/conversations");
		if (!response.IsSuccessStatusCode) { toastMessage = "Impossible de charger les conversations."; return; }
		var summaries = await response.Content.ReadFromJsonAsync<List<ConversationSummaryResponse>>() ?? [];
		var unsentConversations = state.Conversations.Where(conversation => messageDrafts.TryGetValue(conversation.ProfileId, out var draft) && !string.IsNullOrWhiteSpace(draft) && summaries.All(summary => summary.OtherUserId != conversation.ProfileId)).ToList();
		state.Conversations = summaries.Select(summary => new Conversation
		{
			ProfileId = summary.OtherUserId,
			ProfileName = summary.DisplayName,
			Area = summary.City,
			DistanceKm = 0,
			PhotoUrl = FindProfile(summary.OtherUserId)?.PhotoUrl ?? CreateProfilePlaceholder(summary.DisplayName),
			Messages = [new ChatMessage { Text = summary.LastMessage, SentAt = summary.LastSentAt.LocalDateTime }]
		}).ToList();
		state.Conversations.AddRange(unsentConversations);
	}
